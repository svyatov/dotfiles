{
  "attribution": false,
  "autoCompactWindow": 500000,
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 90,
  "disableArtifact": true,
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "editorMode": "normal",
  "effortLevel": "high",
  "enabledPlugins": {
    "adopt-release@svyatov-agent-toolkit": true,
    "atomic-commits@svyatov-agent-toolkit": true,
    "browser-compat@svyatov-agent-toolkit": true,
    "browser-qa@svyatov-agent-toolkit": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true,
    "cut-release@svyatov-agent-toolkit": true,
    "debrief-skill@svyatov-agent-toolkit": true,
    "dependabot-review@svyatov-agent-toolkit": true,
    "dependency-vetting@svyatov-agent-toolkit": true,
    "feature-dev@claude-plugins-official": false,
    "generate-dockerfile@svyatov-agent-toolkit": true,
    "generate-favicon@svyatov-agent-toolkit": true,
    "gopls-lsp@claude-plugins-official": false,
    "grill-me@svyatov-agent-toolkit": true,
    "handrail@handrail": true,
    "humanizer@svyatov-agent-toolkit": true,
    "import-skill@svyatov-agent-toolkit": true,
    "improve-architecture@svyatov-agent-toolkit": true,
    "improve-tests@svyatov-agent-toolkit": true,
    "jury@svyatov-agent-toolkit": true,
    "llms-visibility@svyatov-agent-toolkit": true,
    "oss-kit@oss-kit": true,
    "plugin-dev@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "prior-art@svyatov-agent-toolkit": true,
    "pyright-lsp@claude-plugins-official": true,
    "refactor@svyatov-agent-toolkit": true,
    "report-upstream@svyatov-agent-toolkit": true,
    "ruby-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "shortcuts@svyatov-agent-toolkit": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "verify-marketplace@svyatov-agent-toolkit": true,
    "verify-skill@svyatov-agent-toolkit": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "autoUpdate": true,
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    },
    "goland-claude-marketplace": {
      "source": {
        "repo": "JetBrains/go-modern-guidelines",
        "source": "github"
      }
    },
    "handrail": {
      "autoUpdate": true,
      "source": {
        "repo": "svyatov/handrail",
        "source": "github"
      }
    },
    "oss-kit": {
      "autoUpdate": true,
      "source": {
        "repo": "svyatov/oss-kit",
        "source": "github"
      }
    },
    "ponytail": {
      "autoUpdate": true,
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "svyatov-agent-toolkit": {
      "autoUpdate": true,
      "source": {
        "repo": "svyatov/agent-toolkit",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "filepath=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$filepath\" ] && echo \"$filepath\" | grep -qE '\\.md$'; then markdownlint-cli2 \"$filepath\" 2>&1 | tail -20; fi",
            "statusMessage": "Markdown lint...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/leonid/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "codegraph prompt-hook",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "outputStyle": "Simple",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Edit",
      "Write",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bun:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(uv:*)",
      "Bash(ruby:*)",
      "Bash(gem:*)",
      "Bash(rails:*)",
      "Bash(rake:*)",
      "Bash(bundle:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(rtk:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(docker:*)",
      "Bash(golangci-lint:*)",
      "mcp__codegraph__*"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.env.*.local)",
      "Read(//**/.npmrc)",
      "Read(//**/.netrc)",
      "Read(//**/.pypirc)",
      "Read(//**/.git-credentials)",
      "Read(//**/secrets/**)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.secrets)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gem/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.kube/config)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.claude/.credentials.json)",
      "Bash(*.env)",
      "Bash(*.env.local)",
      "Bash(*.env.development)",
      "Bash(*.env.production)",
      "Bash(*.env.staging)",
      "Bash(*.env.test)",
      "Bash(*.env.*.local)",
      "Bash(*.npmrc)",
      "Bash(*.netrc)",
      "Bash(*.pypirc)",
      "Bash(*.git-credentials)",
      "Bash(*id_rsa)",
      "Bash(*id_ed25519)",
      "Bash(*.pem)",
      "Bash(*.secrets)",
      "Bash(*.aws/credentials)",
      "Bash(*gh/hosts.yml)",
      "Bash(*.docker/config.json)",
      "Bash(*.gem/credentials)",
      "Bash(*.cargo/credentials.toml)",
      "Bash(*.kube/config)",
      "Bash(*credentials.tfrc.json)",
      "Bash(*.claude/.credentials.json)",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "preferredNotifChannel": "ghostty",
  "prefersReducedMotion": true,
  "skillOverrides": {
    "agent-browser": "user-invocable-only",
    "ast-grep": "off",
    "computer-use": "off",
    "graphify": "user-invocable-only",
    "humanizer-ru": "off",
    "impeccable": "user-invocable-only",
    "orchestration": "off",
    "pishi": "off",
    "style-profile": "user-invocable-only"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "timeFormat": "24-hour",
  "tui": "fullscreen",
  "voiceEnabled": true
}
