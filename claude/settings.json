{
  "agentPushNotifEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "high",
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "commit@leo-toolkit": false,
    "compound-engineering@compound-engineering-plugin": true,
    "feature-dev@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "grill-me@leo-toolkit": true,
    "hookify@claude-plugins-official": true,
    "humanizer@leo-toolkit": true,
    "layered-rails@palkan-skills": true,
    "oss-kit@oss-kit": true,
    "plugin-dev@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "repo-prose@leo-toolkit": false,
    "ruby-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "sentry@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "writing-clearly-and-concisely@leo-toolkit": false
  },
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "autoUpdate": true,
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    },
    "leo-toolkit": {
      "autoUpdate": true,
      "source": {
        "repo": "svyatov/agent-toolkit",
        "source": "github"
      }
    },
    "oss-kit": {
      "autoUpdate": true,
      "source": {
        "repo": "svyatov/oss-kit",
        "source": "github"
      }
    },
    "palkan-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "palkan/skills",
        "source": "github"
      }
    },
    "ponytail": {
      "autoUpdate": true,
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "filepath=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$filepath\" ] && echo \"$filepath\" | grep -qE '\\.md$'; then markdownlint-cli2 \"$filepath\" 2>&1 | tail -20; fi",
            "statusMessage": "Markdown lint...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Edit",
      "Write",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bun:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(ruby:*)",
      "Bash(gem:*)",
      "Bash(rails:*)",
      "Bash(rake:*)",
      "Bash(bundle:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(rtk:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(docker:*)",
      "Bash(golangci-lint:*)",
      "Skill(commit:commit)",
      "Read(env.ts)",
      "Read(*.example)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./secrets/**/*)",
      "Read(~/.ssh/**)",
      "Read(~/.secrets)"
    ]
  },
  "preferredNotifChannel": "ghostty",
  "prefersReducedMotion": true,
  "remoteControlAtStartup": false,
  "skillOverrides": {
    "agent-browser": "user-invocable-only",
    "ast-grep": "user-invocable-only",
    "claude-code-setup:claude-automation-recommender": "user-invocable-only",
    "claude-md-management:claude-md-improver": "user-invocable-only",
    "claude-md-management:revise-claude-md": "user-invocable-only",
    "compound-engineering:ce-babysit-pr": "user-invocable-only",
    "compound-engineering:ce-code-review": "user-invocable-only",
    "compound-engineering:ce-commit": "user-invocable-only",
    "compound-engineering:ce-compound": "user-invocable-only",
    "compound-engineering:ce-debug": "user-invocable-only",
    "compound-engineering:ce-dogfood": "user-invocable-only",
    "compound-engineering:ce-explain": "user-invocable-only",
    "compound-engineering:ce-handoff": "user-invocable-only",
    "compound-engineering:ce-optimize": "user-invocable-only",
    "compound-engineering:ce-polish": "user-invocable-only",
    "compound-engineering:ce-pov": "user-invocable-only",
    "compound-engineering:ce-product-pulse": "user-invocable-only",
    "compound-engineering:ce-promote": "user-invocable-only",
    "compound-engineering:ce-proof": "user-invocable-only",
    "compound-engineering:ce-resolve-pr-feedback": "user-invocable-only",
    "compound-engineering:ce-riffrec-feedback-analysis": "user-invocable-only",
    "compound-engineering:ce-setup": "user-invocable-only",
    "compound-engineering:ce-simplify-code": "user-invocable-only",
    "compound-engineering:ce-strategy": "user-invocable-only",
    "compound-engineering:ce-sweep": "user-invocable-only",
    "compound-engineering:ce-test-browser": "user-invocable-only",
    "compound-engineering:ce-test-xcode": "user-invocable-only",
    "compound-engineering:ce-worktree": "user-invocable-only",
    "compound-engineering:lfg": "user-invocable-only",
    "computer-use": "off",
    "graphify": "user-invocable-only",
    "hookify:configure": "user-invocable-only",
    "hookify:help": "user-invocable-only",
    "hookify:hookify": "user-invocable-only",
    "hookify:list": "user-invocable-only",
    "hookify:writing-rules": "user-invocable-only",
    "humanizer-ru": "off",
    "impeccable": "user-invocable-only",
    "layered-rails": "user-invocable-only",
    "layered-rails:layered-rails": "user-invocable-only",
    "orca-cli": "off",
    "orchestration": "off",
    "oss-audit": "user-invocable-only",
    "oss-changelog": "user-invocable-only",
    "oss-ci": "user-invocable-only",
    "oss-community": "user-invocable-only",
    "oss-harden": "user-invocable-only",
    "oss-kit:oss-audit": "user-invocable-only",
    "oss-kit:oss-changelog": "user-invocable-only",
    "oss-kit:oss-ci": "user-invocable-only",
    "oss-kit:oss-community": "user-invocable-only",
    "oss-kit:oss-harden": "user-invocable-only",
    "oss-kit:oss-publish": "user-invocable-only",
    "oss-kit:oss-readme": "user-invocable-only",
    "oss-kit:oss-skill": "user-invocable-only",
    "oss-publish": "user-invocable-only",
    "oss-readme": "user-invocable-only",
    "oss-skill": "user-invocable-only",
    "pishi": "off",
    "plugin-dev:agent-development": "user-invocable-only",
    "plugin-dev:command-development": "user-invocable-only",
    "plugin-dev:create-plugin": "user-invocable-only",
    "plugin-dev:hook-development": "user-invocable-only",
    "plugin-dev:mcp-integration": "user-invocable-only",
    "plugin-dev:plugin-settings": "user-invocable-only",
    "plugin-dev:plugin-structure": "user-invocable-only",
    "plugin-dev:skill-development": "user-invocable-only",
    "ponytail:ponytail-audit": "user-invocable-only",
    "ponytail:ponytail-debt": "user-invocable-only",
    "ponytail:ponytail-gain": "user-invocable-only",
    "ponytail:ponytail-help": "user-invocable-only",
    "ponytail:ponytail-review": "user-invocable-only",
    "skill-creator:skill-creator": "user-invocable-only",
    "style-profile": "user-invocable-only",
    "supacode-cli": "off"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen",
  "voiceEnabled": true,
  "worktree": {
    "baseRef": "fresh"
  }
}
