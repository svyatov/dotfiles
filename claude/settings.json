{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactWindow": 200000,
  "cleanupPeriodDays": 90,
  "disableArtifact": true,
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "effortLevel": "high",
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "commit@leo-toolkit": false,
    "compound-engineering@compound-engineering-plugin": true,
    "feature-dev@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "grill-me@leo-toolkit": true,
    "hookify@claude-plugins-official": true,
    "humanizer@leo-toolkit": true,
    "layered-rails@palkan-skills": true,
    "mattpocock-skills@claude-plugins-official": true,
    "oss-kit@oss-kit": true,
    "plugin-dev@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "repo-prose@leo-toolkit": false,
    "ruby-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "sentry@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "writing-clearly-and-concisely@leo-toolkit": false
  },
  "env": {
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "autoUpdate": true,
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    },
    "leo-toolkit": {
      "autoUpdate": true,
      "source": {
        "repo": "svyatov/agent-toolkit",
        "source": "github"
      }
    },
    "oss-kit": {
      "autoUpdate": true,
      "source": {
        "repo": "svyatov/oss-kit",
        "source": "github"
      }
    },
    "palkan-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "palkan/skills",
        "source": "github"
      }
    },
    "ponytail": {
      "autoUpdate": true,
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "filepath=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$filepath\" ] && echo \"$filepath\" | grep -qE '\\.md$'; then markdownlint-cli2 \"$filepath\" 2>&1 | tail -20; fi",
            "statusMessage": "Markdown lint...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "serena-hooks remind --client=claude-code",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "serena-hooks auto-approve --client=claude-code",
            "type": "command"
          }
        ],
        "matcher": "mcp__serena__*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "serena-hooks cleanup --client=claude-code",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "serena-hooks activate --client=claude-code",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "opus[1m]",
  "outputStyle": "Simple",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Edit",
      "Write",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bun:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(ruby:*)",
      "Bash(gem:*)",
      "Bash(rails:*)",
      "Bash(rake:*)",
      "Bash(bundle:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(rtk:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(docker:*)",
      "Bash(golangci-lint:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.env.*.local)",
      "Read(//**/.npmrc)",
      "Read(//**/.netrc)",
      "Read(//**/.pypirc)",
      "Read(//**/.git-credentials)",
      "Read(//**/secrets/**)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.secrets)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gem/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.kube/config)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.claude/.credentials.json)",
      "Bash(*.env)",
      "Bash(*.env.local)",
      "Bash(*.env.development)",
      "Bash(*.env.production)",
      "Bash(*.env.staging)",
      "Bash(*.env.test)",
      "Bash(*.env.*.local)",
      "Bash(*.npmrc)",
      "Bash(*.netrc)",
      "Bash(*.pypirc)",
      "Bash(*.git-credentials)",
      "Bash(*id_rsa)",
      "Bash(*id_ed25519)",
      "Bash(*.pem)",
      "Bash(*.secrets)",
      "Bash(*.aws/credentials)",
      "Bash(*gh/hosts.yml)",
      "Bash(*.docker/config.json)",
      "Bash(*.gem/credentials)",
      "Bash(*.cargo/credentials.toml)",
      "Bash(*.kube/config)",
      "Bash(*credentials.tfrc.json)",
      "Bash(*.claude/.credentials.json)",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "preferredNotifChannel": "ghostty",
  "prefersReducedMotion": true,
  "skillOverrides": {
    "agent-browser": "user-invocable-only",
    "ast-grep": "off",
    "computer-use": "off",
    "graphify": "user-invocable-only",
    "humanizer-ru": "off",
    "impeccable": "user-invocable-only",
    "orchestration": "off",
    "pishi": "off",
    "style-profile": "user-invocable-only",
    "supacode-cli": "off",
    "supacode-deeplinks": "off"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen",
  "voiceEnabled": true
}
