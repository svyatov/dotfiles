{
  "agentPushNotifEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "high",
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit@leo-toolkit": false,
    "compound-engineering@compound-engineering-plugin": true,
    "feature-dev@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "grill-me@leo-toolkit": true,
    "hookify@claude-plugins-official": true,
    "humanizer@leo-toolkit": true,
    "layered-rails@palkan-skills": true,
    "oss-kit@oss-kit": true,
    "plugin-dev@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "repo-prose@leo-toolkit": true,
    "ruby-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "sentry@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "writing-clearly-and-concisely@leo-toolkit": true
  },
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "autoUpdate": true,
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    },
    "context-mode": {
      "autoUpdate": true,
      "source": {
        "repo": "mksglu/context-mode",
        "source": "github"
      }
    },
    "leo-toolkit": {
      "autoUpdate": true,
      "source": {
        "repo": "svyatov/agent-toolkit",
        "source": "github"
      }
    },
    "oss-kit": {
      "source": {
        "repo": "svyatov/oss-kit",
        "source": "github"
      }
    },
    "palkan-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "palkan/skills",
        "source": "github"
      }
    },
    "ponytail": {
      "autoUpdate": true,
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "filepath=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$filepath\" ] && echo \"$filepath\" | grep -qE '\\.md$'; then markdownlint-cli2 \"$filepath\" 2>&1 | tail -20; fi",
            "statusMessage": "Markdown lint...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"/Users/leonid/.claude/hooks/context-mode-cache-heal.mjs\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Edit",
      "Write",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bun:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(ruby:*)",
      "Bash(gem:*)",
      "Bash(rails:*)",
      "Bash(rake:*)",
      "Bash(bundle:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(rtk:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(docker:*)",
      "Bash(golangci-lint:*)",
      "Skill(commit:commit)",
      "Read(env.ts)",
      "Read(*.example)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./secrets/**/*)",
      "Read(~/.ssh/**)",
      "Read(~/.secrets)"
    ]
  },
  "preferredNotifChannel": "ghostty",
  "prefersReducedMotion": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen",
  "voiceEnabled": true,
  "worktree": {
    "baseRef": "fresh"
  }
}
